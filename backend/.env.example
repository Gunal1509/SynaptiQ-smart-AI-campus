# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=campus

# JWT Secret Key
JWT_SECRET=your_jwt_secret_here

# Server Port
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=ai_campus

# YouTube Data API v3 Configuration (Leave blank to use intelligent curated educational pool)
YOUTUBE_API_KEY=

# Groq Cloud API Key (Free key from https://console.groq.com/keys for Llama 3.3 70B live inference)
GROQ_API_KEY=gsk_your_key_here
